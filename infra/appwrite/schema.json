{
  "$schema": "./schema.schema.json",
  "version": 3,
  "database": {
    "id": "igos-core",
    "name": "IGOS Core"
  },
  "tables": [
    {
      "id": "mats",
      "name": "Multi-Academy Trusts",
      "permissions": "server-only",
      "columns": [
        "name:string:256:required",
        "slug:string:64:required:unique",
        "status:enum(active,suspended):required",
        "settings:json:optional"
      ]
    },
    {
      "id": "academies",
      "name": "Academies",
      "permissions": "tenant-scoped",
      "columns": [
        "matId:string:36:required:index",
        "name:string:256:required",
        "urn:string:16:optional",
        "status:enum(active,inactive):required"
      ]
    },
    {
      "id": "memberships",
      "name": "Memberships",
      "permissions": "tenant-scoped",
      "columns": [
        "matId:string:36:required:index",
        "userId:string:36:required:index",
        "academyIds:string[]:optional",
        "roles:string[]:required",
        "status:enum(invited,active,suspended):required"
      ]
    },
    {
      "id": "matters",
      "name": "Matters",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "reference:string:64:required:unique",
        "type:enum(sar,foi,breach,dpia):required:index",
        "status:enum(draft,open,awaiting-information,review,approved,closed):required:index",
        "title:string:512:required",
        "ownerUserId:string:36:required:index",
        "statutoryDueAt:datetime:optional:index",
        "version:integer:required"
      ]
    },
    {
      "id": "audit-events",
      "name": "Audit Events",
      "permissions": "append-only-server",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "matterId:string:36:optional:index",
        "actorUserId:string:36:required",
        "action:string:128:required:index",
        "occurredAt:datetime:required:index",
        "correlationId:string:64:required:index",
        "previousHash:string:64:optional",
        "payloadHash:string:64:required",
        "metadata:json:required"
      ]
    },
    {
      "id": "documents",
      "name": "Document Metadata",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "matterId:string:36:required:index",
        "storageFileId:string:36:required:unique",
        "name:string:512:required",
        "mimeType:string:128:required",
        "size:integer:required",
        "checksum:string:64:required",
        "retentionClass:string:64:required",
        "status:enum(active,quarantined,disposed):required"
      ]
    },
    {
      "id": "deadline-adjustments",
      "name": "Deadline Adjustments",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "matterId:string:36:required:index",
        "kind:enum(extension,pause):required:index",
        "reason:string:64:required:index",
        "startedAt:datetime:optional",
        "resumedAt:datetime:optional",
        "originalDueAt:datetime:optional",
        "revisedDueAt:datetime:optional",
        "rationale:string:10000:required",
        "recordedByUserId:string:36:required",
        "approvedByUserId:string:36:optional",
        "createdAt:datetime:required:index"
      ]
    },
    {
      "id": "notification-receipts",
      "name": "Notification Receipts",
      "permissions": "server-only",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "matterId:string:36:optional:index",
        "provider:string:64:required",
        "externalId:string:256:required",
        "purpose:string:64:required:index",
        "recipients:string[]:required",
        "sentAt:datetime:required:index",
        "idempotencyKey:string:256:required:index"
      ]
    },
    {
      "id": "dpia-sections",
      "name": "DPIA Sections",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "matterId:string:36:required:index",
        "sectionKey:string:64:required:index",
        "assignedRole:enum(requester,supplier,compliance,dpo):required:index",
        "assignedUserId:string:36:optional:index",
        "status:enum(not-started,in-progress,submitted,accepted,changes-requested):required:index",
        "answers:json:required",
        "submittedAt:datetime:optional",
        "acceptedAt:datetime:optional",
        "version:integer:required"
      ]
    },
    {
      "id": "dpia-risks",
      "name": "DPIA Risks",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "matterId:string:36:required:index",
        "description:string:10000:required",
        "affectedPeople:string[]:required",
        "likelihood:integer:required",
        "impact:integer:required",
        "controlEffectiveness:integer:required",
        "mitigations:string[]:required",
        "ownerUserId:string:36:required:index",
        "dueAt:datetime:optional:index",
        "acceptedByUserId:string:36:optional",
        "acceptanceRationale:string:10000:optional"
      ]
    },
    {
      "id": "processing-activities",
      "name": "Processing Activities",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyIds:string[]:required",
        "name:string:512:required:index",
        "ownerUserId:string:36:required:index",
        "purpose:string:10000:required",
        "dataSubjectCategories:string[]:required",
        "personalDataCategories:string[]:required",
        "specialCategoryData:boolean:required",
        "criminalOffenceData:boolean:required",
        "lawfulBasis:string:64:required:index",
        "specialCategoryCondition:string:128:optional",
        "recipients:string[]:required",
        "processors:string[]:required",
        "internationalTransfers:json:required",
        "retentionRule:string:2000:required",
        "securityMeasures:string[]:required",
        "sourceSystems:string[]:required",
        "destinationSystems:string[]:required",
        "status:enum(draft,active,under-review,retired):required:index",
        "lastReviewedAt:datetime:optional",
        "nextReviewAt:datetime:required:index",
        "version:integer:required"
      ]
    },
    {
      "id": "policies",
      "name": "Policies",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyIds:string[]:required",
        "title:string:512:required:index",
        "ownerUserId:string:36:required:index",
        "versionLabel:string:32:required",
        "status:enum(draft,in-review,approved,published,retired):required:index",
        "reviewDueAt:datetime:required:index",
        "documentId:string:36:required",
        "approvedByUserId:string:36:optional",
        "approvedAt:datetime:optional",
        "publishedAt:datetime:optional",
        "supersedesPolicyId:string:36:optional"
      ]
    },
    {
      "id": "policy-acknowledgements",
      "name": "Policy Acknowledgements",
      "permissions": "tenant-scoped",
      "columns": [
        "matId:string:36:required:index",
        "policyId:string:36:required:index",
        "policyVersion:string:32:required",
        "userId:string:36:required:index",
        "assignedAt:datetime:required",
        "dueAt:datetime:required:index",
        "acknowledgedAt:datetime:optional",
        "exceptionId:string:36:optional"
      ]
    },
    {
      "id": "policy-exceptions",
      "name": "Policy Exceptions",
      "permissions": "tenant-and-academy-scoped",
      "columns": [
        "matId:string:36:required:index",
        "academyId:string:36:optional:index",
        "policyId:string:36:required:index",
        "requestedByUserId:string:36:required",
        "rationale:string:10000:required",
        "compensatingControls:string[]:required",
        "expiresAt:datetime:required:index",
        "approvedByUserId:string:36:optional",
        "approvedAt:datetime:optional"
      ]
    }
  ],
  "buckets": [
    {
      "id": "case-documents",
      "name": "Case Documents",
      "maximumFileSize": 26214400,
      "encryption": true,
      "antivirus": true,
      "permissions": "tenant-and-academy-scoped"
    }
  ]
}
